############
# Secrets
# WICHTIG: Diese Werte MUESSEN vor der Produktionsnutzung geaendert werden!
############

# PostgreSQL Konfiguration
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# JWT Konfiguration
# Generiere mit: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXP=3600

# API Keys
# Generiere diese Keys mit dem JWT_SECRET auf https://supabase.com/docs/guides/self-hosting#api-keys
# Oder nutze das mitgelieferte Skript: ./scripts/generate-keys.sh
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dBOxNWcOOYz7xRgdEXmUWT6LuoR0v8W8d5u1hGpbJoU

# Secret Key Base fuer Realtime (32 Zeichen)
SECRET_KEY_BASE=UpNxBIrdCfXpBzjhR2LLLRcK0gCiYcQTXRUGJaZiCNvQrAJE

############
# URLs & Ports
############

# Externe URL wo die API erreichbar ist
API_EXTERNAL_URL=http://localhost:8000

# URL der Frontend-Anwendung
SITE_URL=http://localhost:3000

# Zusaetzliche Redirect URLs (kommagetrennt)
ADDITIONAL_REDIRECT_URLS=

# Kong Ports
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Studio Port
STUDIO_PORT=3000

############
# Auth Konfiguration
############

# Registrierung deaktivieren
DISABLE_SIGNUP=false

# Email Einstellungen
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# Anonyme Benutzer erlauben
ENABLE_ANONYMOUS_USERS=false

# Telefon Einstellungen
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# SMTP Konfiguration (fuer Email-Versand)
############

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_ADMIN_EMAIL=admin@example.com

# Email URL Pfade
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# Studio Konfiguration
############

STUDIO_DEFAULT_ORGANIZATION=Meine Organisation
STUDIO_DEFAULT_PROJECT=Mein Projekt

# Dashboard Authentifizierung
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=your-dashboard-password

############
# Analytics
############

LOGFLARE_API_KEY=your-logflare-api-key

############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT=false

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,storage,graphql_public
