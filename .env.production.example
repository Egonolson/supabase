############
# Production Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an
############

# Basis-Konfiguration aus .env.example einbinden
# (Alle Werte aus .env.example werden benoetigt)

############
# Domain & SSL (Traefik)
############

# Deine Domain (ohne https://)
DOMAIN=supabase.example.com

# Email fuer Let's Encrypt Zertifikate
ACME_EMAIL=admin@example.com

# Traefik Dashboard Auth (generieren mit: htpasswd -nb admin password)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz...

# Dashboard Auth fuer Studio (htpasswd Format)
DASHBOARD_AUTH=admin:$$apr1$$xyz...

# Monitoring Auth (htpasswd Format)
MONITORING_AUTH=admin:$$apr1$$xyz...

############
# Backup Konfiguration
############

# Cron Schedule fuer Backups (Standard: 02:00 Uhr taeglich)
BACKUP_SCHEDULE=0 2 * * *

# Anzahl Tage, die Backups aufbewahrt werden
BACKUP_RETENTION_DAYS=7

# Storage-Dateien auch sichern?
BACKUP_STORAGE=true

# Optional: Webhook URL fuer Backup-Benachrichtigungen
BACKUP_WEBHOOK_URL=

# Optional: S3/MinIO fuer Remote-Backups
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

############
# Monitoring (Prometheus/Grafana)
############

# Prometheus Port (intern)
PROMETHEUS_PORT=9090

# Grafana Port (intern)
GRAFANA_PORT=3001

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password

############
# Vault (Secrets Management)
############

# Vault Port
VAULT_PORT=8200

# Vault Root Token (generieren mit: openssl rand -hex 16)
VAULT_ROOT_TOKEN=your-vault-root-token

############
# Production URLs (mit Domain)
############

# Diese ueberschreiben die Basis-Konfiguration
API_EXTERNAL_URL=https://api.${DOMAIN}
SITE_URL=https://${DOMAIN}
